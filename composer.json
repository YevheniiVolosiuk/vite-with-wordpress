{
    "name": "stubbornweb/vite-with-wordpress",
    "description": "A simple, elegant Vite integration for WordPress themes and plugins — inspired by Laravel's Vite helper, providing seamless asset management, HMR support, and production-ready manifest handling. ",
    "keywords": [
        "stubborn",
        "stubbornweb",
        "vite-with-wordpress",
        "wordpress",
        "vite"
    ],
    "homepage": "https://github.com/yevheniivolosiuk/vite-with-wordpress",
    "license": "MIT",
    "authors": [
        {
            "name": "Yevhenii Volosiuk",
            "email": "volosiukweb@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "StubbornWeb\\ViteWithWordPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StubbornWeb\\ViteWithWordPress\\\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
            "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
